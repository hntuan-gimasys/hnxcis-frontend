# ---------------------------------------------------------------------------
# HNX-CIS Frontend — local development
# Copy to `.env` (never commit the real file).
# ---------------------------------------------------------------------------

# Backend the Vite dev server proxies /api to.
VITE_DEV_API_PROXY="http://localhost:8080"

# Optional: bake the backend URL into the bundle at build time.
# Leave empty in normal deployments — production reads API_BASE_URL at runtime
# from /env.js (generated by the container entrypoint), so the frontend image
# does not need rebuilding when the backend URL changes.
VITE_API_BASE_URL=""

# Dev server port (Vite default 5173).
PORT="5173"
