server {
    # Cloud Run injects PORT (8080 by default). Substituted at container start
    # by the nginx image's 20-envsubst-on-templates.sh entrypoint script.
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    root /usr/share/nginx/html;
    index index.html;

    # Cloud Run terminates TLS and already gzips responses, but keep this on for
    # direct/container-to-container traffic.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Container health check used by Cloud Run / uptime checks.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"hnxcis-frontend"}';
    }

    # Runtime config must never be cached: it carries the backend URL and is
    # rewritten on every container start.
    location = /env.js {
        add_header Cache-Control "no-store, must-revalidate" always;
        default_type application/javascript;
    }

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
